        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_publicacoes",
        "title": "Listar publicações",
        "description": "Lista as publicações institucionais da APOGESP (estudos, notas técnicas, boletins).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
